import { useState, useEffect, useMemo, useRef, useCallback } from "react";
import {
  Home, PlusCircle, Tag, Wallet, PieChart as PieChartIcon, Camera, X, Check,
  Trash2, Edit2, Settings as SettingsIcon, ChevronLeft, ChevronRight,
  AlertTriangle, Repeat, Bell, Loader2, ImageOff, ArrowLeft
} from "lucide-react";
import {
  BarChart, Bar, PieChart, Pie, Cell, XAxis, YAxis, CartesianGrid,
  Tooltip, ResponsiveContainer, Legend
} from "recharts";

// ---------- Design tokens (Arctic look) ----------
const C = {
  primary: "#2B7FE0",
  accent: "#3C82DC",
  bg: "#FAFBFD",
  card: "#FFFFFF",
  line: "#E6EBF2",
  text: "#1C2733",
  sub: "#7C8AA0",
  danger: "#E15550",
  warn: "#E0A62B",
  ok: "#2FAE6B",
};
const PIE_COLORS = ["#2B7FE0", "#3C82DC", "#6FA8E8", "#A7CBF2", "#5AC8C0", "#7C8AA0"];

const DEFAULT_CATEGORIES = [
  { id: "cat-lebensmittel", name: "Lebensmittel", icon: "🛒", budgetLimit: 350, deleted: false },
  { id: "cat-transport", name: "Transport", icon: "🚗", budgetLimit: 120, deleted: false },
  { id: "cat-wohnen", name: "Wohnen", icon: "🏠", budgetLimit: 900, deleted: false },
  { id: "cat-freizeit", name: "Freizeit", icon: "🎉", budgetLimit: 150, deleted: false },
  { id: "cat-sonstiges", name: "Sonstiges", icon: "📦", budgetLimit: 100, deleted: false },
];
const DEFAULT_SETTINGS = { notifTime: "20:00", warn80: 80, warn100: 100, notifEnabled: true };

const uid = () => Math.random().toString(36).slice(2) + Date.now().toString(36);
const todayISO = () => new Date().toISOString().slice(0, 10);
const ymOf = (dateStr) => dateStr.slice(0, 7);
const monthLabel = (ym) => {
  const [y, m] = ym.split("-").map(Number);
  return new Date(y, m - 1, 1).toLocaleDateString("de-DE", { month: "long", year: "numeric" });
};
const eur = (n) => (Number(n) || 0).toLocaleString("de-DE", { style: "currency", currency: "EUR" });
const lastDayOfMonth = (y, mIdx) => new Date(y, mIdx + 1, 0).getDate();

// ---------- Storage helpers ----------
async function loadKey(key, fallback) {
  try {
    const r = await window.storage.get(key);
    return r ? JSON.parse(r.value) : fallback;
  } catch {
    return fallback;
  }
}
async function saveKey(key, value) {
  try {
    await window.storage.set(key, JSON.stringify(value));
  } catch {
    // silent fail; UI keeps working in-memory
  }
}

export default function App() {
  const [loading, setLoading] = useState(true);
  const [page, setPage] = useState("dashboard");
  const [categories, setCategories] = useState(DEFAULT_CATEGORIES);
  const [expenses, setExpenses] = useState([]);
  const [fixedTemplates, setFixedTemplates] = useState([]);
  const [settings, setSettings] = useState(DEFAULT_SETTINGS);
  const [meta, setMeta] = useState({ lastFixedAppliedMonth: null });
  const [dismissedWarnings, setDismissedWarnings] = useState({});
  const [settingsOpen, setSettingsOpen] = useState(false);

  // ---------- Load ----------
  useEffect(() => {
    (async () => {
      const [cats, exps, fixed, sett, m] = await Promise.all([
        loadKey("km:categories", DEFAULT_CATEGORIES),
        loadKey("km:expenses", []),
        loadKey("km:fixedTemplates", []),
        loadKey("km:settings", DEFAULT_SETTINGS),
        loadKey("km:meta", { lastFixedAppliedMonth: null }),
      ]);
      setCategories(cats);
      setFixedTemplates(fixed);
      setSettings(sett);

      // Apply due fixed costs (handles month-length / leap-year edge cases via clamping)
      const now = new Date();
      const ym = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
      let nextExpenses = exps;
      let nextMeta = m;
      if (m.lastFixedAppliedMonth !== ym && fixed.length) {
        const ld = lastDayOfMonth(now.getFullYear(), now.getMonth());
        const additions = [];
        fixed.filter((t) => t.active).forEach((t) => {
          const alreadyExists = exps.some((e) => e.fixedTemplateId === t.id && e.date.startsWith(ym));
          if (!alreadyExists) {
            const day = Math.min(t.dayOfMonth, ld);
            additions.push({
              id: uid(),
              amount: t.amount,
              date: `${ym}-${String(day).padStart(2, "0")}`,
              categoryId: t.categoryId,
              receiptPhoto: null,
              isFixed: true,
              fixedTemplateId: t.id,
              note: t.name,
            });
          }
        });
        nextExpenses = [...exps, ...additions];
        nextMeta = { lastFixedAppliedMonth: ym };
        await saveKey("km:expenses", nextExpenses);
        await saveKey("km:meta", nextMeta);
      }
      setExpenses(nextExpenses);
      setMeta(nextMeta);
      setLoading(false);
    })();
  }, []);

  // ---------- Persist on change (after initial load) ----------
  const firstRun = useRef(true);
  useEffect(() => {
    if (firstRun.current) { firstRun.current = false; return; }
    saveKey("km:categories", categories);
  }, [categories]);
  useEffect(() => { if (!loading) saveKey("km:expenses", expenses); }, [expenses, loading]);
  useEffect(() => { if (!loading) saveKey("km:fixedTemplates", fixedTemplates); }, [fixedTemplates, loading]);
  useEffect(() => { if (!loading) saveKey("km:settings", settings); }, [settings, loading]);

  const activeCategories = useMemo(() => categories.filter((c) => !c.deleted), [categories]);
  const currentYm = useMemo(() => todayISO().slice(0, 7), []);

  const monthExpenses = useMemo(
    () => expenses.filter((e) => ymOf(e.date) === currentYm),
    [expenses, currentYm]
  );

  const spentByCategory = useMemo(() => {
    const map = {};
    monthExpenses.forEach((e) => { map[e.categoryId] = (map[e.categoryId] || 0) + Number(e.amount); });
    return map;
  }, [monthExpenses]);

  const budgetWarnings = useMemo(() => {
    return activeCategories
      .filter((c) => c.budgetLimit > 0)
      .map((c) => {
        const spent = spentByCategory[c.id] || 0;
        const pct = (spent / c.budgetLimit) * 100;
        return { ...c, spent, pct };
      })
      .filter((c) => c.pct >= settings.warn80)
      .filter((c) => !dismissedWarnings[c.id + "-" + Math.floor(c.pct / 10)]);
  }, [activeCategories, spentByCategory, settings.warn80, dismissedWarnings]);

  if (loading) {
    return (
      <div style={{ background: C.bg }} className="min-h-screen flex items-center justify-center">
        <Loader2 className="animate-spin" size={28} color={C.primary} />
      </div>
    );
  }

  return (
    <div style={{ background: C.bg, color: C.text }} className="min-h-screen font-sans flex flex-col max-w-md mx-auto relative">
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap');
        .font-sans { font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; }
        .font-display { font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif; }
        * { -webkit-tap-highlight-color: transparent; }
        input, select { font-family: inherit; }
      `}</style>

      <Header page={page} onSettings={() => setSettingsOpen(true)} />

      <main className="flex-1 overflow-y-auto pb-24 px-4 pt-3">
        {page === "dashboard" && (
          <Dashboard
            categories={activeCategories}
            spentByCategory={spentByCategory}
            monthExpenses={monthExpenses}
            currentYm={currentYm}
            warnings={budgetWarnings}
            onDismiss={(c) => setDismissedWarnings((d) => ({ ...d, [c.id + "-" + Math.floor(c.pct / 10)]: true }))}
            goErfassen={() => setPage("erfassen")}
          />
        )}
        {page === "erfassen" && (
          <Erfasser
            categories={activeCategories}
            onSave={(exp) => { setExpenses((es) => [...es, exp]); setPage("dashboard"); }}
            onCancel={() => setPage("dashboard")}
          />
        )}
        {page === "kategorien" && (
          <Kategorien
            categories={categories}
            expenses={expenses}
            setCategories={setCategories}
            setExpenses={setExpenses}
          />
        )}
        {page === "budget" && (
          <BudgetPlaner
            categories={activeCategories}
            setCategories={setCategories}
            fixedTemplates={fixedTemplates}
            setFixedTemplates={setFixedTemplates}
          />
        )}
        {page === "analyse" && (
          <Auswertung categories={categories} expenses={expenses} />
        )}
      </main>

      <BottomNav page={page} setPage={setPage} />

      {settingsOpen && (
        <SettingsModal settings={settings} setSettings={setSettings} onClose={() => setSettingsOpen(false)} />
      )}
    </div>
  );
}

// ---------- Header ----------
const TITLES = {
  dashboard: "Kosten-Übersicht",
  erfassen: "Ausgabe erfassen",
  kategorien: "Kategorien",
  budget: "Budget-Planer",
  analyse: "Auswertung",
};
