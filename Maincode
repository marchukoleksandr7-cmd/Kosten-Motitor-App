// ---------- Auswertungs-Analyse ----------
function Auswertung({ categories, expenses }) {
  const allMonths = useMemo(() => {
    const set = new Set(expenses.map((e) => ymOf(e.date)));
    set.add(todayISO().slice(0, 7));
    return [...set].sort();
  }, [expenses]);
  const [selectedYm, setSelectedYm] = useState(allMonths[allMonths.length - 1]);
  const idx = allMonths.indexOf(selectedYm);

  const monthData = expenses.filter((e) => ymOf(e.date) === selectedYm);
  const total = monthData.reduce((s, e) => s + Number(e.amount), 0);

  const byCategory = useMemo(() => {
    const map = {};
    monthData.forEach((e) => {
      const cat = categories.find((c) => c.id === e.categoryId);
      const name = cat ? `${cat.icon} ${cat.name}` : "Sonstiges";
      map[name] = (map[name] || 0) + Number(e.amount);
    });
    return Object.entries(map).map(([name, value]) => ({ name, value }));
  }, [monthData, categories]);

  const last6 = allMonths.slice(-6);
  const comparisonData = last6.map((ym) => ({
    ym: monthLabel(ym).split(" ")[0].slice(0, 3),
    total: expenses.filter((e) => ymOf(e.date) === ym).reduce((s, e) => s + Number(e.amount), 0),
  }));

  return (
    <div className="flex flex-col gap-4">
      <div className="flex items-center justify-between rounded-xl p-2" style={{ background: C.card, border: `1px solid ${C.line}` }}>
        <button disabled={idx <= 0} onClick={() => setSelectedYm(allMonths[idx - 1])} className="p-2 disabled:opacity-30">
          <ChevronLeft size={18} color={C.sub} />
        </button>
        <span className="text-sm font-semibold font-display">{monthLabel(selectedYm)}</span>
        <button disabled={idx >= allMonths.length - 1} onClick={() => setSelectedYm(allMonths[idx + 1])} className="p-2 disabled:opacity-30">
          <ChevronRight size={18} color={C.sub} />
        </button>
      </div>

      <div className="rounded-2xl p-4 text-center" style={{ background: C.card, border: `1px solid ${C.line}` }}>
        <p className="text-xs" style={{ color: C.sub }}>Gesamtausgaben</p>
        <p className="font-display font-extrabold text-2xl mt-1">{eur(total)}</p>
      </div>
      <div className="rounded-2xl p-4" style={{ background: C.card, border: `1px solid ${C.line}` }}>
        <p className="font-display font-bold text-sm mb-2">Verteilung nach Kategorie</p>
        {byCategory.length === 0 ? (
          <p className="text-sm py-6 text-center" style={{ color: C.sub }}>Keine Ausgaben in diesem Monat.</p>
        ) : (
          <ResponsiveContainer width="100%" height={220}>
            <PieChart>
              <Pie data={byCategory} dataKey="value" nameKey="name" cx="50%" cy="50%" innerRadius={45} outerRadius={80} paddingAngle={2}>
                {byCategory.map((_, i) => <Cell key={i} fill={PIE_COLORS[i % PIE_COLORS.length]} />)}
              </Pie>
              <Tooltip formatter={(v) => eur(v)} />
              <Legend wrapperStyle={{ fontSize: 11 }} />
            </PieChart>
          </ResponsiveContainer>
        )}
      </div>

      <div className="rounded-2xl p-4" style={{ background: C.card, border: `1px solid ${C.line}` }}>
        <p className="font-display font-bold text-sm mb-2">Monatsvergleich</p>
        <ResponsiveContainer width="100%" height={200}>
          <BarChart data={comparisonData}>
            <CartesianGrid strokeDasharray="3 3" stroke={C.line} vertical={false} />
            <XAxis dataKey="ym" tick={{ fontSize: 11, fill: C.sub }} axisLine={false} tickLine={false} />
            <YAxis tick={{ fontSize: 11, fill: C.sub }} axisLine={false} tickLine={false} width={36} />
            <Tooltip formatter={(v) => eur(v)} />
            <Bar dataKey="total" fill={C.primary} radius={[6, 6, 0, 0]} />
          </BarChart>
        </ResponsiveContainer>
      </div>
    </div>
  );
}

