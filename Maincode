}
// ---------- Dashboard ----------
function Dashboard({ categories, spentByCategory, monthExpenses, currentYm, warnings, onDismiss, goErfassen }) {
  const total = monthExpenses.reduce((s, e) => s + Number(e.amount), 0);
  const totalBudget = categories.reduce((s, c) => s + (Number(c.budgetLimit) || 0), 0);

  return (
    <div className="flex flex-col gap-4">
      {/* Total card */}
      <div
        className="rounded-2xl p-5 text-white"
        style={{ background: `linear-gradient(135deg, ${C.primary}, ${C.accent})` }}
      >
        <p className="text-xs opacity-80 font-medium">{monthLabel(currentYm)}</p>
        <p className="font-display font-extrabold text-3xl mt-1">{eur(total)}</p>
        {totalBudget > 0 && (
          <>
            <div className="mt-3 h-2 rounded-full bg-white/25 overflow-hidden">
              <div
                className="h-full rounded-full bg-white"
                style={{ width: `${Math.min(100, (total / totalBudget) * 100)}%` }}
              />
            </div>
            <p className="text-xs opacity-80 mt-1.5">von {eur(totalBudget)} Gesamtbudget</p>
          </>
        )}
      </div>

      {/* Warnings */}
      {warnings.length > 0 && (
        <div className="flex flex-col gap-2">
          {warnings.map((w) => {
            const over = w.pct >= 100;
            return (
              <div
                key={w.id}
                className="rounded-xl p-3 flex items-start gap-2.5"
                style={{ background: over ? "#FCEAEA" : "#FDF3E1", border: `1px solid ${over ? "#F5C9C7" : "#F3DFB0"}` }}
              >
                <AlertTriangle size={18} color={over ? C.danger : C.warn} className="mt-0.5 shrink-0" />
                <div className="flex-1">
                  <p className="text-sm font-semibold" style={{ color: over ? C.danger : "#8A6410" }}>
                    {w.icon} {w.name}: {Math.round(w.pct)}% des Budgets
                  </p>
                  <p className="text-xs mt-0.5" style={{ color: C.sub }}>
                    {eur(w.spent)} von {eur(w.budgetLimit)} {over ? "— Budget überschritten" : "ausgegeben"}
                  </p>
                </div>
                <button onClick={() => onDismiss(w)} className="p-1"><X size={14} color={C.sub} /></button>
              </div>
            );
          })}
        </div>
      )}

      {/* Category progress */}
      <div className="rounded-2xl p-4" style={{ background: C.card, border: `1px solid ${C.line}` }}>
        <p className="font-display font-bold text-sm mb-3" style={{ color: C.text }}>Budgets nach Kategorie</p>
        {categories.filter((c) => c.budgetLimit > 0).length === 0 && (
          <p className="text-sm" style={{ color: C.sub }}>Noch keine Budgets festgelegt.</p>
        )}
        <div className="flex flex-col gap-3">
          {categories.filter((c) => c.budgetLimit > 0).map((c) => {
            const spent = spentByCategory[c.id] || 0;
            const pct = Math.min(100, (spent / c.budgetLimit) * 100);
            const over = spent > c.budgetLimit;
            return (
              <div key={c.id}>
                <div className="flex justify-between text-xs mb-1">
                  <span style={{ color: C.text }}>{c.icon} {c.name}</span>
                  <span style={{ color: over ? C.danger : C.sub }}>{eur(spent)} / {eur(c.budgetLimit)}</span>
                </div>
                <div className="h-1.5 rounded-full" style={{ background: C.line }}>
                  <div
                    className="h-full rounded-full"
                    style={{ width: `${pct}%`, background: over ? C.danger : pct >= 80 ? C.warn : C.primary }}
                  />
                </div>
              </div>
            );
          })}
        </div>
      </div>

      {/* Recent expenses */}
      <div className="rounded-2xl p-4" style={{ background: C.card, border: `1px solid ${C.line}` }}>
        <p className="font-display font-bold text-sm mb-3">Letzte Ausgaben</p>
        {monthExpenses.length === 0 ? (
          <button onClick={goErfassen} className="text-sm w-full text-center py-6" style={{ color: C.sub }}>
            Noch keine Ausgaben in diesem Monat.<br />
            <span style={{ color: C.primary }} className="font-medium">Erste Ausgabe erfassen →</span>
          </button>
        ) : (
          <div className="flex flex-col gap-2.5">
            {[...monthExpenses].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 6).map((e) => {
              const cat = categories.find((c) => c.id === e.categoryId);
              return (
                <div key={e.id} className="flex items-center justify-between">
                  <div className="flex items-center gap-2.5">
                    <div className="w-9 h-9 rounded-full flex items-center justify-center text-base" style={{ background: C.bg }}>
                      {cat?.icon || "📦"}
                    </div>
                    <div>
                      <p className="text-sm font-medium">{cat?.name || "Gelöschte Kategorie"} {e.isFixed && <Repeat size={11} className="inline ml-1" color={C.sub} />}</p>
                      <p className="text-xs" style={{ color: C.sub }}>{new Date(e.date).toLocaleDateString("de-DE")}</p>
                    </div>
                  </div>
                  <span className="text-sm font-semibold">{eur(e.amount)}</span>
                </div>
              );
            })}
          </div>
        )}
      </div>
    </div>
  );
}

// ---------- Ausgaben-Erfasser ----------
function Erfasser({ categories, onSave, onCancel }) {
  const [amount, setAmount] = useState("");
  const [date, setDate] = useState(todayISO());
  const [categoryId, setCategoryId] = useState(categories[0]?.id || "");
  const [photo, setPhoto] = useState(null);
  const [scanning, setScanning] = useState(false);
  const [scanNotice, setScanNotice] = useState(null);
  const fileRef = useRef(null);

  const handleFile = async (file) => {
    if (!file) return;
    const reader = new FileReader();
    reader.onload = async () => {
      const dataUrl = reader.result;
      const base64 = dataUrl.split(",")[1];
      const mediaType = file.type || "image/jpeg";
      setPhoto(dataUrl);
      setScanning(true);
      setScanNotice(null);
      try {
        const response = await fetch("https://api.anthropic.com/v1/messages", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            model: "claude-sonnet-4-6",
            max_tokens: 1000,
            messages: [{
              role: "user",
              content: [
                { type: "image", source: { type: "base64", media_type: mediaType, data: base64 } },
                {
                  type: "text",
                  text: "Das ist ein Foto eines Kassenbons/Belegs. Extrahiere den Gesamtbetrag (als Zahl mit Punkt als Dezimaltrennzeichen) und das Datum (Format YYYY-MM-DD). Antworte AUSSCHLIESSLICH mit einem JSON-Objekt, keine Erklärung, kein Markdown: {\"amount\": <Zahl oder null>, \"date\": \"YYYY-MM-DD\" oder null, \"readable\": true oder false}. Setze readable auf false, wenn der Beleg unscharf, abgeschnitten oder unlesbar ist.",
                },
              ],
            }],
          }),
        });
        const data = await response.json();
        const text = (data.content || []).filter((b) => b.type === "text").map((b) => b.text).join("");
        const clean = text.replace(/```json|```/g, "").trim();
        const parsed = JSON.parse(clean);
        if (!parsed.readable || parsed.amount == null) {
          setScanNotice({ type: "warn", msg: "Beleg konnte nicht sicher gelesen werden. Bitte Betrag und Datum manuell prüfen." });
        } else {
          if (parsed.amount) setAmount(String(parsed.amount));
          if (parsed.date && /^\d{4}-\d{2}-\d{2}$/.test(parsed.date)) setDate(parsed.date);
          setScanNotice({ type: "ok", msg: "Betrag und Datum wurden automatisch erkannt — bitte kurz prüfen." });
        }
      } catch (err) {
        setScanNotice({ type: "warn", msg: "Scan fehlgeschlagen. Bitte Betrag und Datum manuell eingeben." });
      } finally {
        setScanning(false);
      }
    };
    reader.readAsDataURL(file);
  };

  const canSave = amount && Number(amount) > 0 && categoryId && date;
  const save = () => {
    onSave({
      id: uid(),
      amount: Number(amount),
      date,
      categoryId,
      receiptPhoto: photo,
      isFixed: false,
      note: "",
    });
  };

  return (
    <div className="flex flex-col gap-4">
      <button onClick={onCancel} className="flex items-center gap-1.5 text-sm font-medium" style={{ color: C.sub }}>
        <ArrowLeft size={16} /> Zurück
      </button>

      {/* Receipt scan */}
      <div className="rounded-2xl p-4" style={{ background: C.card, border: `1px solid ${C.line}` }}>
        <input
          ref={fileRef}
          type="file"
          accept="image/*"
          capture="environment"
          className="hidden"
          onChange={(e) => handleFile(e.target.files?.[0])}
        />
        {!photo ? (
          <button
            onClick={() => fileRef.current?.click()}
            className="w-full flex flex-col items-center justify-center gap-2 py-8 rounded-xl border-2 border-dashed active:scale-[0.99] transition"
            style={{ borderColor: C.line }}
          >
            <Camera size={26} color={C.primary} />
            <span className="text-sm font-medium" style={{ color: C.primary }}>Beleg scannen</span>
            <span className="text-xs" style={{ color: C.sub }}>Betrag & Datum werden automatisch erkannt</span>
          </button>
        ) : (
          <div className="flex gap-3 items-center">
            <img src={photo} alt="Beleg" className="w-16 h-16 rounded-lg object-cover" style={{ border: `1px solid ${C.line}` }} />
            <div className="flex-1">
              {scanning ? (
                <p className="text-sm flex items-center gap-1.5" style={{ color: C.sub }}>
                  <Loader2 size={14} className="animate-spin" /> Beleg wird analysiert…
                </p>
              ) : scanNotice ? (
                <p className="text-xs" style={{ color: scanNotice.type === "ok" ? C.ok : C.warn }}>
                  {scanNotice.type === "warn" && <ImageOff size={12} className="inline mr-1 -mt-0.5" />}
                  {scanNotice.msg}
                </p>
              ) : null}
              <button onClick={() => { setPhoto(null); setScanNotice(null); }} className="text-xs font-medium mt-1" style={{ color: C.primary }}>
                Foto entfernen
              </button>
            </div>
          </div>
        )}
      </div>

      {/* Form */}
      <div className="rounded-2xl p-4 flex flex-col gap-4" style={{ background: C.card, border: `1px solid ${C.line}` }}>
        <div>
          <label className="text-xs font-medium" style={{ color: C.sub }}>Betrag (€)</label>
          <input
            type="number" inputMode="decimal" step="0.01" placeholder="0,00"
            value={amount} onChange={(e) => setAmount(e.target.value)}
            className="w-full mt-1 text-2xl font-display font-bold outline-none bg-transparent"
            style={{ color: C.text }}
          />
        </div>
        <div className="h-px" style={{ background: C.line }} />
        <div>
          <label className="text-xs font-medium" style={{ color: C.sub }}>Kategorie</label>
          <select
            value={categoryId} onChange={(e) => setCategoryId(e.target.value)}
            className="w-full mt-1 text-sm py-2 rounded-lg outline-none"
            style={{ color: C.text, background: C.bg, border: `1px solid ${C.line}` }}
          >
            {categories.map((c) => <option key={c.id} value={c.id}>{c.icon} {c.name}</option>)}
          </select>
        </div>
        <div>
          <label className="text-xs font-medium" style={{ color: C.sub }}>Datum</label>
          <input
            type="date" value={date} onChange={(e) => setDate(e.target.value)}
            className="w-full mt-1 text-sm py-2 rounded-lg outline-none"
            style={{ color: C.text, background: C.bg, border: `1px solid ${C.line}` }}
          />
        </div>
      </div>

      <button
        disabled={!canSave}
        onClick={save}
        className="w-full py-3.5 rounded-xl font-semibold text-white flex items-center justify-center gap-2 active:scale-[0.99] transition disabled:opacity-40"
        style={{ background: `linear-gradient(135deg, ${C.primary}, ${C.accent})` }}
      >
        <Check size={18} /> Ausgabe speichern
      </button>
    </div>
  );
}

// ---------- Kategorie-Manager ----------
const ICON_CHOICES = ["🛒", "🚗", "🏠", "🎉", "📦", "💊", "🍽️", "👕", "📱", "🎓", "✈️", "🐾", "💡", "🎁"];

function Kategorien({ categories, expenses, setCategories, setExpenses }) {
  const [editing, setEditing] = useState(null); // category or "new"
  const [reassignTarget, setReassignTarget] = useState(null); // category pending delete

  const activeCats = categories.filter((c) => !c.deleted);
  const countFor = (id) => expenses.filter((e) => e.categoryId === id).length;

  const startNew = () => setEditing({ id: null, name: "", icon: "📦", budgetLimit: "" });
  const save = (cat) => {
    if (cat.id) {
      setCategories((cs) => cs.map((c) => (c.id === cat.id ? { ...c, ...cat, budgetLimit: Number(cat.budgetLimit) || 0 } : c)));
    } else {
      setCategories((cs) => [...cs, { ...cat, id: uid(), deleted: false, budgetLimit: Number(cat.budgetLimit) || 0 }]);
    }
    setEditing(null);
  };

  const requestDelete = (cat) => {
    if (countFor(cat.id) > 0) setReassignTarget(cat);
    else setCategories((cs) => cs.filter((c) => c.id !== cat.id));
  };

  const archiveCategory = (cat) => {
    setCategories((cs) => cs.map((c) => (c.id === cat.id ? { ...c, deleted: true } : c)));
    setReassignTarget(null);
  };
  const reassignAndDelete = (cat, targetId) => {
    setExpenses((es) => es.map((e) => (e.categoryId === cat.id ? { ...e, categoryId: targetId } : e)));
    setCategories((cs) => cs.filter((c) => c.id !== cat.id));
    setReassignTarget(null);
  };

  return (
    <div className="flex flex-col gap-3">
      <button
        onClick={startNew}
        className="w-full py-3 rounded-xl font-semibold text-sm flex items-center justify-center gap-2 active:scale-[0.99] transition"
        style={{ color: C.primary, background: "#EAF2FD", border: `1px dashed ${C.primary}` }}
      >
        <PlusCircle size={17} /> Neue Kategorie
      </button>

      <div className="flex flex-col gap-2">
        {activeCats.map((c) => (
          <div key={c.id} className="rounded-xl p-3.5 flex items-center justify-between" style={{ background: C.card, border: `1px solid ${C.line}` }}>
            <div className="flex items-center gap-3">
              <div className="w-10 h-10 rounded-full flex items-center justify-center text-lg" style={{ background: C.bg }}>{c.icon}</div>
              <div>
                <p className="text-sm font-semibold">{c.name}</p>
                <p className="text-xs" style={{ color: C.sub }}>{c.budgetLimit > 0 ? `Budget: ${eur(c.budgetLimit)}` : "Kein Budget"} · {countFor(c.id)} Ausgaben</p>
              </div>
            </div>
            <div className="flex items-center gap-1">
              <button onClick={() => setEditing(c)} className="p-2"><Edit2 size={15} color={C.sub} /></button>
              <button onClick={() => requestDelete(c)} className="p-2"><Trash2 size={15} color={C.danger} /></button>
            </div>
          </div>
        ))}
        {activeCats.length === 0 && <p className="text-sm text-center py-6" style={{ color: C.sub }}>Keine Kategorien vorhanden.</p>}
      </div>

      {categories.some((c) => c.deleted) && (
        <details className="text-xs mt-2" style={{ color: C.sub }}>
          <summary className="cursor-pointer font-medium">Archivierte Kategorien</summary>
          <div className="mt-2 flex flex-col gap-1.5">
            {categories.filter((c) => c.deleted).map((c) => (
              <div key={c.id} className="flex items-center justify-between py-1">
                <span>{c.icon} {c.name} ({countFor(c.id)} Ausgaben im Verlauf)</span>
              </div>
            ))}
          </div>
        </details>
      )}

      {editing && (
        <CategoryEditModal cat={editing} onSave={save} onClose={() => setEditing(null)} />
      )}

      {reassignTarget && (
        <ReassignModal
          cat={reassignTarget}
          options={activeCats.filter((c) => c.id !== reassignTarget.id)}
          count={countFor(reassignTarget.id)}
          onArchive={() => archiveCategory(reassignTarget)}
          onReassign={(targetId) => reassignAndDelete(reassignTarget, targetId)}
          onClose={() => setReassignTarget(null)}
        />
      )}
    </div>
  );
}
