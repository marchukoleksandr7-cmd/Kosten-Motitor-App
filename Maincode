  const items = [
    { id: "dashboard", label: "Übersicht", icon: Home },
    { id: "kategorien", label: "Kategorien", icon: Tag },
    { id: "erfassen", label: "", icon: PlusCircle, center: true },
    { id: "budget", label: "Budget", icon: Wallet },
    { id: "analyse", label: "Analyse", icon: PieChartIcon },
  ];
  return (
    <nav
      className="fixed bottom-0 left-0 right-0 max-w-md mx-auto flex items-center justify-around px-2 py-2"
      style={{ background: C.card, borderTop: `1px solid ${C.line}` }}
    >
      {items.map((it) => {
        const Icon = it.icon;
        const active = page === it.id;
        if (it.center) {
          return (
            <button
              key={it.id}
              onClick={() => setPage("erfassen")}
